<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Happy Birthday! 🎉</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  html, body {
    height: 100%;
    overflow-x: hidden;
  }

  body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: linear-gradient(135deg, #ff9a9e 0%, #fad0c4 25%, #fbc2eb 50%, #a18cd1 75%, #fbc2eb 100%);
    background-size: 400% 400%;
    animation: gradientShift 12s ease infinite;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 20px;
  }

  @keyframes gradientShift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  #confetti-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 10;
  }

  .card {
    position: relative;
    z-index: 5;
    background: rgba(255, 255, 255, 0.92);
    border-radius: 24px;
    padding: 40px 30px;
    max-width: 480px;
    width: 100%;
    text-align: center;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(8px);
    animation: popIn 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes popIn {
    0% { transform: scale(0.7); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }

  .balloons {
    font-size: clamp(2rem, 8vw, 3rem);
    margin-bottom: 10px;
    animation: float 3s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }

  h1 {
    font-size: clamp(1.8rem, 6vw, 2.8rem);
    background: linear-gradient(90deg, #ff5f6d, #ffc371, #ff5f6d);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 3s linear infinite;
    margin-bottom: 10px;
    line-height: 1.2;
  }

  @keyframes shine {
    to { background-position: 200% center; }
  }

  .name {
    font-size: clamp(1.3rem, 5vw, 2rem);
    color: #6a3093;
    font-weight: bold;
    margin-bottom: 18px;
  }

  .message {
    font-size: clamp(0.95rem, 3.5vw, 1.15rem);
    color: #444;
    line-height: 1.6;
    margin-bottom: 28px;
    padding: 0 5px;
  }

  .cake {
    font-size: clamp(3rem, 12vw, 4.5rem);
    margin: 10px 0 25px;
    cursor: pointer;
    user-select: none;
    transition: transform 0.2s;
  }

  .cake:active {
    transform: scale(0.9);
  }

  .btn {
    background: linear-gradient(135deg, #ff5f6d, #ffc371);
    color: white;
    border: none;
    padding: 14px 32px;
    font-size: clamp(1rem, 4vw, 1.1rem);
    font-weight: 600;
    border-radius: 50px;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(255, 95, 109, 0.4);
    transition: transform 0.2s, box-shadow 0.2s;
    -webkit-tap-highlight-color: transparent;
  }

  .btn:active {
    transform: scale(0.95);
    box-shadow: 0 4px 12px rgba(255, 95, 109, 0.4);
  }

  .hint {
    margin-top: 14px;
    font-size: 0.8rem;
    color: #999;
  }

  @media (max-width: 380px) {
    .card { padding: 30px 20px; }
  }

  .page {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 480px;
    display: none;
  }

  .page.active {
    display: block;
    animation: popIn 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  #page1.hidden, #page2.hidden {
    display: none;
  }

  .gift {
    font-size: clamp(3.5rem, 14vw, 5rem);
    margin: 15px 0 10px;
  }

  .page2-title {
    font-size: clamp(1.6rem, 5.5vw, 2.3rem);
    color: #6a3093;
    font-weight: bold;
    margin-bottom: 16px;
  }

  .wish-list {
    text-align: left;
    list-style: none;
    margin: 0 auto 26px;
    max-width: 360px;
  }

  .wish-list li {
    font-size: clamp(0.95rem, 3.5vw, 1.05rem);
    color: #444;
    padding: 8px 0 8px 30px;
    position: relative;
    line-height: 1.5;
  }

  .wish-list li::before {
    content: "🎁";
    position: absolute;
    left: 0;
    top: 6px;
  }

  .backBtn {
    background: transparent;
    border: 2px solid #a18cd1;
    color: #6a3093;
    padding: 10px 24px;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 50px;
    cursor: pointer;
    margin-top: 6px;
    -webkit-tap-highlight-color: transparent;
  }

  .backBtn:active {
    transform: scale(0.96);
  }

  .nextBtn {
    background: linear-gradient(135deg, #a18cd1, #fbc2eb);
    color: white;
    border: none;
    padding: 12px 28px;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 50px;
    cursor: pointer;
    margin-top: 10px;
    box-shadow: 0 8px 20px rgba(161, 140, 209, 0.4);
    -webkit-tap-highlight-color: transparent;
  }

  .nextBtn:active {
    transform: scale(0.96);
  }

  .heart-emoji {
    font-size: clamp(3rem, 12vw, 4rem);
    margin: 10px 0;
    animation: float 3s ease-in-out infinite;
  }

  .reason-list {
    text-align: left;
    list-style: none;
    margin: 0 auto 26px;
    max-width: 360px;
  }

  .reason-list li {
    font-size: clamp(0.95rem, 3.5vw, 1.05rem);
    color: #444;
    padding: 8px 0 8px 30px;
    position: relative;
    line-height: 1.5;
  }

  .reason-list li::before {
    content: "💜";
    position: absolute;
    left: 0;
    top: 6px;
  }

  .propose-title {
    font-size: clamp(1.5rem, 5.5vw, 2.1rem);
    color: #d6336c;
    font-weight: bold;
    margin: 14px 0 20px;
    line-height: 1.4;
  }

  .yesno-wrap {
    position: relative;
    display: flex;
    gap: 16px;
    justify-content: center;
    align-items: center;
    margin-top: 20px;
    min-height: 60px;
  }

  .yesBtn {
    background: linear-gradient(135deg, #ff5f6d, #ffc371);
    color: white;
    border: none;
    padding: 14px 30px;
    font-size: 1rem;
    font-weight: 700;
    border-radius: 50px;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(255, 95, 109, 0.4);
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.2s;
  }

  .yesBtn:active {
    transform: scale(0.95);
  }

  .noBtn {
    background: white;
    color: #6a3093;
    border: 2px solid #a18cd1;
    padding: 12px 26px;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 50px;
    cursor: pointer;
    position: relative;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.15s ease;
  }

  #page5 .card {
    background: linear-gradient(135deg, rgba(255,255,255,0.95), rgba(255, 240, 245, 0.95));
  }

  .final-emoji {
    font-size: clamp(3.5rem, 14vw, 5rem);
    margin-bottom: 10px;
  }
</style>
</head>
<body>

<canvas id="confetti-canvas"></canvas>

<div class="page active" id="page1">
  <div class="card">
    <div class="balloons">😍</div>
    <h1>Happiest Birthday</h1>
    <div class="name">AGALYA⚡</div>
    <div class="message">
Hope you have a really beautiful day and a wonderful year ahead.
Unakku pidicha maari neraya happy moments, peace, success ellam kedaikanum 

Always keep smiling and stay the same person you are.
Honestly, you’re someone who is really special to me, and I’m genuinely happy that I know you!

Enjoy your day to the fullest!
Once again, Happy Birthday Thakkaliiii
🫶🫂⚡

    </div>
    <div class="cake" id="cake">🎂</div>
    <button class="btn" id="celebrateBtn">Click pannu🎉</button>
    <div class="hint"> Padichathu Podhum Cake ah 3 Time Click Pannu Apram ah keela click pannu </div>
  </div>
</div>

<div class="page" id="page2">
  <div class="card">
    <div class="gift">⚡</div>
    <div class="page2-title">AGALYA, indha Year unaku Best aa irukanum!</div>
    <ul class="wish-list">
      <li>Nee kanavu kaanura ella dreams-um nijama aganum.</li>
      <li>Unna love pannuravanga, value pannuravanga eppovum un koodave irukanum.</li>
      <li>Indha year happiness, success, nalla memories niraya kidaikanum.</li>
      <li>Eppovum ippadiye smile pannitu, healthy aah iru. </li>
    </ul>
    <div class="btn-row" style="display:flex; gap:10px; justify-content:center; flex-wrap:wrap;">
      <button class="backBtn" id="backBtn">← Back</button>
      <button class="nextBtn" id="toPage3Btn">Next →</button>
    </div>
  </div>
</div>

<div class="page" id="page3">
  <div class="card">
    <div class="heart-emoji">⚡</div>
    <div class="page2-title">Wait pannu Aagavali...</div>
    <div class="message">
      Nee porathuku munnadi, unkitta onnu sollanum-nu ninaichen.
      Nee en-koodu pesura every time-layum, en day konjam better aayiduthu. 🥺
    </div>
    <ul class="reason-list">
      <li>Unna paakumbodhu enakku theriyama oru mari happiness varudhu yanu kuda enaku therila❤️</li>
      <li> Innaikunu illa Normal days-ah kooda nee Enaku special d Thakkali</li>
      <li>Nee kuda unna patthi ivlo yosichiruka maata aana naa irukane ennatha solrathu endha visyam mind la vandhalium uh niyabagam dha varudhu😅</li>
      <li>Un koodu irukumbothu ellame Sari aah iruka mari enaku oru feel adha naa uh kudave iruka aasa padren aana nee dha enna adikadi thitra sanda pora sari vidu paravana Continue kuduthu Next page po.</li>
    </ul>
    <div class="btn-row" style="display:flex; gap:10px; justify-content:center; flex-wrap:wrap;">
      <button class="backBtn" id="backBtn2">← Back</button>
      <button class="nextBtn" id="toPage4Btn">Continue →</button>
    </div>
  </div>
</div>

<div class="page" id="page4">
  <div class="card">
    <div class="heart-emoji">💘</div>
    <div class="propose-title">AGALYA, Keela Padichitu Mudinja Ans Pannu? 💗</div>
    <div class="message">
      Happy Birthday, Agalya! ❤️🎂
Unna paakumbodhum, unkitta pesumbodhum enakku varra andha happiness, Solrathuku Vartha illa🫶
Already once told you how I feel… but I’d still choose to say it again — I really like and Love you Agalya❤️
 So... Madam enna solringa?
    </div>
    <div class="yesno-wrap">
      <button class="yesBtn" id="yesBtn">Yes 💖</button>
      <button class="noBtn" id="noBtn">No</button>
    </div>
  </div>
</div>

<div class="page" id="page5">
  <div class="card">
    <div class="final-emoji">🥰💞🎉</div>
    <div class="propose-title">Yayyy! Ithuve Best Birthday! 🎊</div>
    <div class="message">
      Yes sonnadhuku nandri AGALYA 🥰 Innaiku en vaazhkailayum happiest day aagiduchu.
      Namakaaga, innum niraya birthdays iruku rendu perum serndhu celebrate pannaradhuku. 💗
    </div>
    <button class="backBtn" id="restartBtn">↺ Re-Try</button>
  </div>
</div>

<script>
(function() {
  const canvas = document.getElementById('confetti-canvas');
  const ctx = canvas.getContext('2d');
  let particles = [];
  let animationId;

  function resize() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  }
  resize();
  window.addEventListener('resize', resize);

  const colors = ['#ff5f6d', '#ffc371', '#a18cd1', '#fbc2eb', '#6a3093', '#42e695', '#3bb2b8', '#f9d423'];

  function randomRange(min, max) {
    return Math.random() * (max - min) + min;
  }

  function createParticle(x, y) {
    const shapeType = Math.random() < 0.5 ? 'rect' : 'circle';
    return {
      x: x !== undefined ? x : randomRange(0, canvas.width),
      y: y !== undefined ? y : randomRange(-canvas.height, 0),
      w: randomRange(6, 12),
      h: randomRange(8, 16),
      color: colors[Math.floor(Math.random() * colors.length)],
      speedY: randomRange(2, 5),
      speedX: randomRange(-2, 2),
      rotation: randomRange(0, 360),
      rotationSpeed: randomRange(-8, 8),
      shape: shapeType,
      opacity: 1,
      gravity: randomRange(0.02, 0.06)
    };
  }

  function initialBurst(count) {
    for (let i = 0; i < count; i++) {
      particles.push(createParticle());
    }
  }

  function burstFrom(x, y, count) {
    for (let i = 0; i < count; i++) {
      const p = createParticle(x, y);
      p.speedX = randomRange(-6, 6);
      p.speedY = randomRange(-10, -3);
      particles.push(p);
    }
  }

  function updateAndDraw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    particles.forEach((p) => {
      p.speedY += p.gravity;
      p.x += p.speedX;
      p.y += p.speedY;
      p.rotation += p.rotationSpeed;

      if (p.y > canvas.height + 20) {
        p.opacity -= 1; // mark for removal
      }

      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate((p.rotation * Math.PI) / 180);
      ctx.globalAlpha = Math.max(p.opacity, 0);
      ctx.fillStyle = p.color;

      if (p.shape === 'rect') {
        ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
      } else {
        ctx.beginPath();
        ctx.arc(0, 0, p.w / 2, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.restore();
    });

    particles = particles.filter(p => p.opacity > 0 && p.y < canvas.height + 50);

    animationId = requestAnimationFrame(updateAndDraw);
  }

  // Initial celebration burst
  initialBurst(120);
  updateAndDraw();

  // Keep a gentle trickle of confetti falling from the top
  setInterval(() => {
    if (particles.length < 150) {
      for (let i = 0; i < 3; i++) {
        particles.push(createParticle(randomRange(0, canvas.width), -20));
      }
    }
  }, 300);

  // Big burst on button tap, then move to page 2
  const btn = document.getElementById('celebrateBtn');
  const page1 = document.getElementById('page1');
  const page2 = document.getElementById('page2');
  const page3 = document.getElementById('page3');
  const page4 = document.getElementById('page4');
  const page5 = document.getElementById('page5');
  const backBtn = document.getElementById('backBtn');
  const backBtn2 = document.getElementById('backBtn2');
  const toPage3Btn = document.getElementById('toPage3Btn');
  const toPage4Btn = document.getElementById('toPage4Btn');
  const yesBtn = document.getElementById('yesBtn');
  const noBtn = document.getElementById('noBtn');
  const restartBtn = document.getElementById('restartBtn');

  function goTo(fromPage, toPage, burst) {
    fromPage.classList.remove('active');
    toPage.classList.add('active');
    if (burst) {
      burstFrom(canvas.width / 2, canvas.height * 0.3, 60);
    }
    window.scrollTo(0, 0);
  }

  btn.addEventListener('click', () => {
    burstFrom(canvas.width / 2, canvas.height * 0.6, 100);
    setTimeout(() => {
      goTo(page1, page2, true);
    }, 500);
  });

  backBtn.addEventListener('click', () => goTo(page2, page1, false));
  toPage3Btn.addEventListener('click', () => goTo(page2, page3, false));
  backBtn2.addEventListener('click', () => goTo(page3, page2, false));
  toPage4Btn.addEventListener('click', () => goTo(page3, page4, false));

  yesBtn.addEventListener('click', () => {
    burstFrom(canvas.width / 2, canvas.height * 0.4, 150);
    sendWhatsAppNotify('YES 💗');
    setTimeout(() => {
      goTo(page4, page5, true);
    }, 400);
  });

  // WhatsApp notify - opens WhatsApp with a pre-filled message to notify you of the answer
  const YOUR_WHATSAPP_NUMBER = '919751230905'; // country code + number, no + or spaces
  function sendWhatsAppNotify(answer) {
    const message = encodeURIComponent('AGALYA replied: ' + answer + ' 🎉 (from the birthday site)');
    const waLink = 'https://wa.me/' + YOUR_WHATSAPP_NUMBER + '?text=' + message;
    window.open(waLink, '_blank');
  }

  // Playful dodge: "No" button runs away when tapped/hovered
  let noMoves = 0;
  function dodgeNoButton() {
    const wrap = noBtn.closest('.yesno-wrap');
    const wrapRect = wrap.getBoundingClientRect();
    const btnRect = noBtn.getBoundingClientRect();
    const maxX = wrapRect.width - btnRect.width;
    const maxY = 80;
    const randX = randomRange(-maxX / 2, maxX / 2);
    const randY = randomRange(-maxY / 2, maxY / 2);
    noBtn.style.position = 'relative';
    noBtn.style.left = randX + 'px';
    noBtn.style.top = randY + 'px';
    noMoves++;
    if (noMoves >= 3) {
      noBtn.textContent = "Sari, Yes thaan solren 🙈";
    }
  }
  noBtn.addEventListener('mouseover', dodgeNoButton);
  noBtn.addEventListener('touchstart', (e) => {
    e.preventDefault();
    dodgeNoButton();
  }, { passive: false });
  noBtn.addEventListener('click', (e) => {
    e.preventDefault();
    dodgeNoButton();
  });

  restartBtn.addEventListener('click', () => {
    goTo(page5, page1, false);
    noBtn.style.left = '0px';
    noBtn.style.top = '0px';
    noBtn.textContent = 'No';
    noMoves = 0;
  });

  // Burst on cake tap
  const cake = document.getElementById('cake');
  cake.addEventListener('click', (e) => {
    const rect = cake.getBoundingClientRect();
    burstFrom(rect.left + rect.width / 2, rect.top + rect.height / 2, 80);
  });

  // Also support touch directly for snappier mobile response
  [btn, cake, backBtn, backBtn2, toPage3Btn, toPage4Btn, yesBtn, restartBtn].forEach(el => {
    el.addEventListener('touchstart', function(e) {
      // click event will still fire; this just ensures no delay issues
    }, { passive: true });
  });
})();
</script>

</body>
</html>
